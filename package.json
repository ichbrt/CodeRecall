{
  "name": "coderecall",
  "version": "0.1.0-alpha.1",
  "description": "Local engineering memory for coding agents. Don't regenerate. Recall and reuse.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "license": "MIT",
  "author": "Berat Demirci",
  "repository": { "type": "git", "url": "git+https://github.com/ichbrt/CodeRecall.git" },
  "homepage": "https://github.com/ichbrt/CodeRecall#readme",
  "bugs": { "url": "https://github.com/ichbrt/CodeRecall/issues" },
  "keywords": ["mcp", "coding-agents", "code-reuse", "local-first", "engineering-memory", "cli"],
  "engines": { "node": ">=24.0.0" },
  "bin": { "coderecall": "dist/cli.js" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "README.md", "LICENSE", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "docs", "examples"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "commander": "^14.0.3",
    "ignore": "^7.0.5",
    "semver": "^7.7.4",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@types/semver": "^7.7.1",
    "eslint": "^10.10.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.57.0"
  }
}
